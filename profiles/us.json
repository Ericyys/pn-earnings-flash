{
  "profile_version": "1.0",
  "market": "us",
  "label": "美股",
  "defaults": {
    "currency": "USD",
    "monetary_unit": "millions",
    "share_unit": "millions",
    "accounting_basis": "US GAAP",
    "display_unit": "billions",
    "display_currency_prefix": "US$"
  },
  "extraction_prompt": "prompts/extract_us.md",
  "primary_sources": [
    {
      "type": "press_release",
      "note": "財報新聞稿，通常以 8-K 附件 Exhibit 99.1 申報，公布當天即可取得"
    },
    {
      "type": "investor_deck",
      "note": "部分公司另有法說簡報，部門與 KPI 常在這裡"
    },
    {
      "type": "financial_statements",
      "note": "10-Q 多半晚幾天才申報，24 小時內通常還沒有"
    }
  ],
  "line_item_aliases": {
    "revenue": [
      "Total revenue",
      "Total revenues",
      "Revenue",
      "Revenues",
      "Net sales",
      "Total net sales",
      "Net revenue"
    ],
    "cost_of_revenue": [
      "Cost of revenue",
      "Cost of revenues",
      "Cost of sales",
      "Total cost of revenue"
    ],
    "gross_profit": [
      "Gross profit",
      "Gross margin"
    ],
    "rd_expense": [
      "Research and development"
    ],
    "sm_expense": [
      "Sales and marketing",
      "Selling and marketing"
    ],
    "ga_expense": [
      "General and administrative"
    ],
    "sga_expense": [
      "Selling, general and administrative"
    ],
    "operating_expenses_total": [
      "Total operating expenses"
    ],
    "operating_income": [
      "Operating income",
      "Income from operations",
      "Operating income (loss)"
    ],
    "non_operating_net": [
      "Total other income (expense), net",
      "Other income (expense), net",
      "Interest and other income (expense), net"
    ],
    "pretax_income": [
      "Income before income taxes",
      "Income before provision for income taxes"
    ],
    "income_tax": [
      "Provision for income taxes",
      "Income tax expense"
    ],
    "net_income": [
      "Net income",
      "Net income (loss)"
    ],
    "net_income_to_parent": [
      "Net income attributable to",
      "Net income"
    ],
    "eps_basic": [
      "Basic"
    ],
    "eps_diluted": [
      "Diluted"
    ],
    "shares_diluted": [
      "Diluted",
      "Weighted-average shares used in computing diluted"
    ],
    "other_operating_net": []
  },
  "alias_warnings": [
    "「Gross margin」在部分公司的損益表裡是毛利金額，不是毛利率，看單位判斷",
    "「Diluted」同時出現在 EPS 和股數兩區，必須看所在區塊",
    "「Net income」與「Net income attributable to ...」並存時，EPS 用歸屬母公司的那一列"
  ],
  "sign_conventions": {
    "rule": "AI 一律照抄原文正負號；這裡定義各科目「原文正數代表什麼」，供網頁計算時使用",
    "positive_means": {
      "revenue": "收入",
      "cost_of_revenue": "成本",
      "gross_profit": "毛利",
      "rd_expense": "費用",
      "sm_expense": "費用",
      "ga_expense": "費用",
      "sga_expense": "費用",
      "operating_expenses_total": "費用",
      "other_operating_net": "收益（負數＝費損）",
      "operating_income": "利益",
      "non_operating_net": "收益（負數＝損失）",
      "pretax_income": "利益",
      "income_tax": "費用（負數＝所得稅利益）",
      "net_income": "利益",
      "capex": "現金流入（原文通常為負數，計算時取絕對值）",
      "buybacks": "現金流入（原文通常為負數，計算時取絕對值）",
      "dividends_paid": "現金流入（原文通常為負數，計算時取絕對值）"
    },
    "identities": [
      "gross_profit = revenue − cost_of_revenue",
      "operating_income = gross_profit − operating_expenses_total + other_operating_net（沒有該列視為 0）",
      "pretax_income = operating_income + non_operating_net",
      "net_income = pretax_income − income_tax"
    ]
  },
  "fiscal_calendar_warning": "多家美股公司財年與日曆年錯開（例如財年 Q4 對應日曆 Q3），一律以 company.json 的 fiscal_year_end_month 對照，圖卡上同時標示財年季度與期末日。",
  "required_fields": [
    "income_statement.revenue",
    "income_statement.cost_of_revenue",
    "income_statement.gross_profit",
    "income_statement.operating_income",
    "income_statement.net_income",
    "income_statement.eps_diluted",
    "income_statement.shares_diluted"
  ],
  "qc_checks": {
    "segment_sum_vs_revenue": {
      "enabled": true
    },
    "geography_sum_vs_revenue": {
      "enabled": true
    },
    "gross_profit_identity": {
      "enabled": true
    },
    "operating_income_identity": {
      "enabled": true
    },
    "pretax_identity": {
      "enabled": true
    },
    "net_income_identity": {
      "enabled": true
    },
    "eps_identity": {
      "enabled": true,
      "tolerance_per_share": 0.01
    },
    "margin_range": {
      "enabled": true
    },
    "yoy_outlier": {
      "enabled": true,
      "abs_percent": 100
    },
    "stated_metrics_match": {
      "enabled": true,
      "tolerance_pp": 0.1
    },
    "prior_year_vs_history": {
      "enabled": true
    },
    "fcf_stated_match": {
      "enabled": true
    },
    "non_gaap_basis_lock": {
      "enabled": true,
      "note": "E 模組比較 EPS 時，實際值、財測、市場預期必須是同一個基準；基準不同就停用該項比較"
    }
  },
  "rounding_tolerance": {
    "rule": "原文最小顯示位數的 1 個單位",
    "note": "例如原文以百萬美元整數列示，勾稽誤差容許 ±1；容許值只吸收四捨五入，不設百分比容許"
  },
  "module_overrides": {
    "E": {
      "enabled": true,
      "requires": "上一季存檔中的 guidance_next，或本季人工填寫的 consensus"
    }
  }
}