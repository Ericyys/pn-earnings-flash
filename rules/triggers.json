{
  "rules_version": "1.0",
  "comment": "第 1 步的選圖規則。門檻是起始值，試跑後在這裡調整，不用改程式。所有指標由網頁從核對過的數據計算，AI 不參與選圖。",
  "deck": {
    "fixed": [
      "A1",
      "C",
      "K1"
    ],
    "max_conditional": 2,
    "order_on_deck": [
      "A1",
      "C",
      "E",
      "B",
      "D",
      "F",
      "G",
      "I",
      "K1"
    ],
    "selection_priority": [
      "E:outside",
      "B",
      "D",
      "F",
      "G",
      "E:inside",
      "I"
    ],
    "priority_note": "條件模組超過 2 個被觸發時，依 selection_priority 取前 2 個；選中後依 order_on_deck 排列張次",
    "fixed_note": "A1、C 一律產出（C 在虧損時改為瀑布圖）；K1 有財測或財測調整時才產出"
  },
  "missing_data_policy": "某條規則需要的數據不存在（例如還沒有 8 季歷史），該條規則視為不觸發，並在選圖結果中列出「因資料不足略過」",
  "metrics": {
    "revenue_yoy": "本季營收 ÷ 去年同期營收 − 1",
    "gross_margin": "毛利 ÷ 營收",
    "operating_margin": "營業利益 ÷ 營收",
    "net_margin": "歸屬母公司淨利 ÷ 營收",
    "gross_margin_change_pp_yoy": "本季毛利率 − 去年同期毛利率（百分點）",
    "gross_margin_change_pp_qoq": "本季毛利率 − 上季毛利率（百分點，上季取自歷史存檔）",
    "operating_margin_change_pp_yoy": "本季營益率 − 去年同期營益率（百分點）",
    "operating_margin_change_pp_qoq": "本季營益率 − 上季營益率（百分點）",
    "margin_8q_extreme": "毛利率或營益率為含本季在內近 8 季最高或最低（需 7 季歷史）",
    "segment_share_change_pp_yoy": "任一非調節部門：本季佔營收比重 − 去年同期比重（百分點），取絕對值最大者",
    "segment_yoy_gap_pp": "任一非調節部門：部門營收年增率 − 公司整體營收年增率（百分點），取絕對值最大者",
    "geo_share_change_pp_yoy": "同 segment_share_change_pp_yoy，套用於地區",
    "non_operating_share_of_net_income": "|業外收支淨額| ÷ |歸屬母公司淨利|",
    "notable_items_share_of_net_income": "公司標示的一次性項目金額絕對值加總 ÷ |歸屬母公司淨利|",
    "guidance_position": "本季實際值相對於上季公司財測區間的位置：below／inside／above（上季財測取自歷史存檔）",
    "consensus_gap": "本季實際值 − 市場預期（同基準才計算）",
    "kpi_extreme": "任一 KPI 為歷史存檔中的最高或最低",
    "kpi_growth_sign_flip": "任一 KPI 的年增率正負號與上季相反",
    "capex_yoy": "|本季資本支出| ÷ |去年同期資本支出| − 1",
    "capital_return_yoy": "(|回購| + |股利|) 本季 ÷ 去年同期 − 1",
    "new_buyback_authorization": "本季數據中有新回購授權",
    "peers_available": "同業本季數據已存在歷史存檔（由 Ryan 在網頁勾選啟用）"
  },
  "modules": {
    "A1": {
      "name": "數字快報封面",
      "template": "T1",
      "type": "fixed"
    },
    "C": {
      "name": "損益流向",
      "template": "T4",
      "type": "fixed",
      "annotations": [
        {
          "id": "highlight_non_operating",
          "when": {
            "any": [
              {
                "metric": "non_operating_share_of_net_income",
                "op": "gte",
                "value": 0.1
              },
              {
                "metric": "notable_items_share_of_net_income",
                "op": "gte",
                "value": 0.1
              }
            ]
          },
          "effect": "在流向圖上另外標出業外或一次性項目，並加註原文名稱"
        }
      ]
    },
    "E": {
      "name": "對比預期",
      "template": "T6",
      "type": "conditional",
      "requires_any": [
        "guidance_position",
        "consensus_gap"
      ],
      "variants": {
        "E:outside": {
          "when": {
            "metric": "guidance_position",
            "op": "in",
            "value": [
              "below",
              "above"
            ]
          }
        },
        "E:inside": {
          "when": {
            "any": [
              {
                "metric": "guidance_position",
                "op": "eq",
                "value": "inside"
              },
              {
                "metric": "consensus_gap",
                "op": "exists"
              }
            ]
          }
        }
      }
    },
    "B": {
      "name": "營收拆解",
      "template": "T2",
      "alt_template": "T5",
      "type": "conditional",
      "when": {
        "any": [
          {
            "metric": "segment_share_change_pp_yoy",
            "op": "abs_gte",
            "value": 3
          },
          {
            "metric": "segment_yoy_gap_pp",
            "op": "abs_gte",
            "value": 10
          },
          {
            "metric": "geo_share_change_pp_yoy",
            "op": "abs_gte",
            "value": 3
          }
        ]
      },
      "template_rule": "預設 T2 堆疊長條；若成長歸因更清楚（單一部門貢獻超過整體增量的 80%），改用 T5 瀑布圖"
    },
    "D": {
      "name": "獲利能力",
      "template": "T3",
      "type": "conditional",
      "when": {
        "any": [
          {
            "metric": "gross_margin_change_pp_yoy",
            "op": "abs_gte",
            "value": 1
          },
          {
            "metric": "gross_margin_change_pp_qoq",
            "op": "abs_gte",
            "value": 1
          },
          {
            "metric": "operating_margin_change_pp_yoy",
            "op": "abs_gte",
            "value": 1
          },
          {
            "metric": "operating_margin_change_pp_qoq",
            "op": "abs_gte",
            "value": 1
          },
          {
            "metric": "margin_8q_extreme",
            "op": "is_true"
          }
        ]
      }
    },
    "F": {
      "name": "關鍵營運指標",
      "template": "T2",
      "alt_template": "T3",
      "type": "conditional",
      "when": {
        "any": [
          {
            "metric": "kpi_extreme",
            "op": "is_true"
          },
          {
            "metric": "kpi_growth_sign_flip",
            "op": "is_true"
          }
        ]
      }
    },
    "G": {
      "name": "現金與資本配置",
      "template": "T5",
      "type": "conditional",
      "when": {
        "any": [
          {
            "metric": "capex_yoy",
            "op": "abs_gte",
            "value": 0.2
          },
          {
            "metric": "capital_return_yoy",
            "op": "abs_gte",
            "value": 0.2
          },
          {
            "metric": "new_buyback_authorization",
            "op": "is_true"
          }
        ]
      }
    },
    "I": {
      "name": "同業對比",
      "template": "T7",
      "type": "conditional",
      "when": {
        "metric": "peers_available",
        "op": "is_true"
      }
    },
    "K1": {
      "name": "下季財測／財測調整",
      "template": "T8",
      "type": "fixed",
      "note": "有公司下季財測或公司明確寫出的財測調整（上修／下修）才產出；兩者都沒有就不產出 K1，不顯示「未提供」。只放公司公布的內容。"
    }
  },
  "market_overrides": {
    "tw": {
      "E": "依 profiles/tw.json：只有 company.json 標示 gives_guidance: true 時啟用"
    }
  },
  "layout_note": "A1 封面與 K1 保留文字；中間的圖卡只放圖，頁首標示公司、季度與圖名，底部保留資料來源（2026-10-27 小組決定）"
}